# balldontlie NFL API key — https://nfl.balldontlie.io
SPORTS_API_KEY=

# Shared secret the hPanel cron job sends as the X-Cron-Secret header when
# calling /api/cron/sync-scores. Generate a long random value; never a
# query param, since those land in access logs.
CRON_SECRET=

# Canonical origin used for metadataBase, sitemap.xml, robots.txt and OG
# image URLs. Leave unset in production (defaults to https://hailmary.ro);
# Vercel preview deploys must set this to their actual preview URL.
SITE_URL=

# Shared secret hailmary-e2e sends as the X-E2E-Secret header when calling
# /api/test/article-count and /api/test/seed-scores. NEVER set this in
# Hostinger production — it's only needed on whatever deployed target
# hailmary-e2e's E2E_BASE_URL actually points at (e.g. a Vercel preview),
# since /api/test/seed-scores can overwrite the live score store.
E2E_TEST_SECRET=
